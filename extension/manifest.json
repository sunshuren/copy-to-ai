{
  "manifest_version": 3,
  "name": "Copy to AI",
  "version": "0.8.2",
  "description": "__MSG_description__",
  "permissions": [
    "clipboardWrite",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "__MSG_copyAI__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "jspdf.js",
        "chatgpt.js"
      ],
      "run_at": "document_idle",
      "css": [
        "feedback.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "reply.ttf"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ],
  "default_locale": "en"
}
